{
  "name": "module-ls",
  "version": "0.1.0",
  "description": "ls for understanding JavaScript and TypeScript codebases",
  "type": "module",
  "bin": {
    "module-ls": "./dist/cli.js",
    "mls": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "SPEC.md"
  ],
  "scripts": {
    "build": "pnpm build:cli && pnpm build:web",
    "build:cli": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "build:web": "pnpm --dir web build",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "dev": "tsx src/cli.ts",
    "dev:web": "pnpm --dir web dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --dir web typecheck"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.20.0",
  "license": "UNLICENSED",
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.112",
    "effect": "4.0.0-rc.112",
    "ignore": "^7.0.6",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
